{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "SNR sim: peak in the middle (2 passes)",
            "type": "debugpy",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "request": "launch",
            "program": "${workspaceFolder}/host/snr_peak.py",
            "args": [
                "--simulate",
                "--sweep",
                "-8",
                "8",
                "1",
                "--plot"
            ],
            "cwd": "${workspaceFolder}/host",
            "console": "integratedTerminal"
        },
        {
            "name": "SNR sim: peak near the edge (2 passes)",
